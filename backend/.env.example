DATABASE_URL=postgres://smartcanteen:change-me@localhost:5432/smart_canteen
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional. When set, startup seeds five demo accounts (admin, canteen, two
# students, staff) that all share this password. Leave it unset in production,
# or every deployment starts with accounts whose password is in the source.
# DEMO_USER_PASSWORD=change-me